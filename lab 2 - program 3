import random
import time
import matplotlib.pyplot as plt
import math


def merge_sort(arr):
    if len(arr) > 1:
        mid = len(arr) // 2

        left = arr[:mid]
        right = arr[mid:]

        merge_sort(left)
        merge_sort(right)

        i = j = k = 0

        # Compare elements of left and right halves
        while i < len(left) and j < len(right):
            if left[i] < right[j]:
                arr[k] = left[i]
                i += 1
            else:
                arr[k] = right[j]
                j += 1

            k += 1

        # Copy remaining elements from left half
        while i < len(left):
            arr[k] = left[i]
            i += 1
            k += 1

        # Copy remaining elements from right half
        while j < len(right):
            arr[k] = right[j]
            j += 1
            k += 1


# Different input sizes
sizes = [100, 500, 1000, 2000, 5000, 10000, 20000]

times = []
theoretical = []


# Measure execution time
for n in sizes:

    arr = [random.randint(1, 10000) for _ in range(n)]

    start = time.perf_counter()

    merge_sort(arr)

    end = time.perf_counter()

    times.append(end - start)

    # Theoretical O(n log n) time
    theoretical.append(n * math.log2(n))


# Scale theoretical values to match measured time
scale = times[-1] / theoretical[-1]

theoretical = [x * scale for x in theoretical]


# Print measured execution time
print("Array Size\tExecution Time (s)")

for n, t in zip(sizes, times):
    print(n, "\t\t", t)


# Plot measured and theoretical time
plt.figure(figsize=(8, 5))

plt.plot(
    sizes,
    times,
    "o-",
    label="Measured Time"
)

plt.plot(
    sizes,
    theoretical,
    "s--",
    label="Theoretical O(n log n)"
)

plt.xlabel("Array Size")
plt.ylabel("Execution Time (s)")
plt.title("Merge Sort Time Complexity")

plt.grid(True)
plt.legend()

plt.show()