arr = [2, 2, 1, 2, 3, 2, 2]

count = 0

# Find candidate
for num in arr:

    if count == 0:
        candidate = num

    if num == candidate:
        count += 1
    else:
        count -= 1

# Count occurrences of candidate
count = 0

for num in arr:
    if num == candidate:
        count += 1

# Check whether candidate is a majority element
if count > len(arr) // 2:
    print("Majority element:", candidate)
else:
    print("No majority element")