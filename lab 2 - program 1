# Program 1: Union and Intersection of Two Sorted Arrays
# Using Two-Pointer Technique

A = [1, 2, 4, 5, 6]
B = [2, 3, 4, 6]

i = 0
j = 0

union = []
intersection = []

while i < len(A) and j < len(B):

    if A[i] < B[j]:
        union.append(A[i])
        i += 1

    elif A[i] > B[j]:
        union.append(B[j])
        j += 1

    else:
        union.append(A[i])
        intersection.append(A[i])
        i += 1
        j += 1

# Add remaining elements from A
while i < len(A):
    union.append(A[i])
    i += 1

# Add remaining elements from B
while j < len(B):
    union.append(B[j])
    j += 1

# Display the results
print("Union:", union)
print("Intersection:", intersection)