arr = [2, 0, 1, 2, 1, 0, 0]

low = 0
mid = 0
high = len(arr) - 1

while mid <= high:

    if arr[mid] == 0:
        # Swap arr[low] and arr[mid]
        arr[low], arr[mid] = arr[mid], arr[low]

        low += 1
        mid += 1

    elif arr[mid] == 1:
        # Move mid forward
        mid += 1

    else:
        # Swap arr[mid] and arr[high]
        arr[mid], arr[high] = arr[high], arr[mid]

        high -= 1

print("Sorted Array:", arr)